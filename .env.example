# ===== ffmpeg-agent 环境变量示例 =====
# 复制为 .env 并填写(注意: .env 已被 gitignore,不会入库)

# ── LLM 配置(必填,也可在页面右上角 ⚙️ 设置中填写;页面配置会持久化并优先) ──
MODEL_NAME=gpt-4o-mini
BASE_URL=https://api.openai.com/v1
API_KEY=sk-...

# ── 访问控制(可选) ──
# 设置后所有 /api/* 接口(除 /api/health)都需携带请求头 X-Auth-Token: <值>
# 或 Authorization: Bearer <值>;前端在设置弹窗中填写相同令牌即可
# AUTH_TOKEN=

# ── 目录与数据(可选,默认值如下) ──
UPLOAD=backend/upload
DOWNLOAD=backend/download
DB_DIR=backend/data/chroma_db
COLLECTION_NAME=ffmpeg_docs
PROBE_COLLECTION_NAME=ffprobe_docs
DOC_URL=https://ffmpeg.org/ffmpeg-all.html
PROBE_DOC_URL=https://ffmpeg.org/ffprobe-all.html
BGE_CACHE_DIR=backend/data/bge_onnx
BGE_MODEL_NAME=BAAI/bge-small-zh-v1.5
# HF_ENDPOINT=https://hf-mirror.com
SETTINGS_FILE=backend/data/llm_settings.json

# ── 行为调优(可选) ──
# 知识库自动刷新:大于 0 时,向量库构建超过该天数会在启动时自动重建
DOC_REFRESH_DAYS=0
# 单条 ffmpeg/ffprobe 命令最长执行时间(秒)
FFMPEG_TIMEOUT=1800
# 单文件上传大小上限(MB,0=不限制)
MAX_UPLOAD_SIZE_MB=2048
# 上传文件扩展名白名单(逗号分隔,空=不限制)
# UPLOAD_EXT_WHITELIST=mp4,mov,mkv,avi,webm,mp3,wav,flac,aac,m4a,jpg,jpeg,png,gif,webp
# 跨域白名单(逗号分隔;前端由后端托管或走 dev 代理,通常无需配置)
# CORS_ORIGINS=
