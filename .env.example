# ===== ffmpeg-agent 环境变量示例 =====
# 复制为 .env 并填写(注意: .env 已被 gitignore,不会入库)

# ── LLM 配置 ──
# 不再通过环境变量配置。模型名称 / 接口地址 / API Key 一律在**页面右上角 ⚙️
# 设置弹窗**中填写，持久化到 backend/data/llm_settings.json（可用 SETTINGS_FILE 改路径）。
# 这样只有一处来源，避免"改了 .env 却不生效"的困惑。

# ── 访问控制(可选) ──
# 设置后所有 /api/* 接口(除 /api/health)都需携带请求头 X-Auth-Token: <值>
# 或 Authorization: Bearer <值>;前端在设置弹窗中填写相同令牌即可
# AUTH_TOKEN=

# ── 目录与数据(可选,默认值如下) ──
UPLOAD=backend/upload
DOWNLOAD=backend/download
DB_DIR=backend/data/chroma_db
COLLECTION_NAME=ffmpeg_docs
PROBE_COLLECTION_NAME=ffprobe_docs
DOC_URL=https://ffmpeg.org/ffmpeg-all.html
PROBE_DOC_URL=https://ffmpeg.org/ffprobe-all.html
BGE_CACHE_DIR=backend/data/bge_onnx
# 说明: 嵌入走 ONNX(onnxruntime+tokenizers),运行时不需要 torch/transformers;
# BGE_CACHE_DIR 必须指向含 model.onnx + tokenizer.json 的目录
# (由 backend/build_bge_onnx.py 生成,见 requirements-build.txt)
SETTINGS_FILE=backend/data/llm_settings.json

# ── 行为调优(可选) ──
# 知识库自动刷新:大于 0 时,向量库构建超过该天数会在启动时自动重建
DOC_REFRESH_DAYS=0
# 单条 ffmpeg/ffprobe 命令最长执行时间(秒)
FFMPEG_TIMEOUT=1800
# ffprobe 只读分析,正常秒级返回;单独设更短超时,避免卡住的探测把分析功能挂起
FFPROBE_TIMEOUT=120
# 同时运行的 ffmpeg 进程数上限。写不同输出文件的请求可并行;
# 设为 1 即退回"完全串行"的旧行为
FFMPEG_MAX_CONCURRENCY=4
# 单文件上传大小上限(MB,0=不限制)
MAX_UPLOAD_SIZE_MB=2048
# 向量检索返回条数(喂给 LLM 的文档片段数)。调大会显著增加提示词长度:
# 实测 ffmpeg 库 k=20 平均约 9.6k token,k=8 约 4.2k token(相关性高的通常只有前 1~2 条)
RETRIEVAL_K=8
# 上传文件扩展名白名单(逗号分隔,空=不限制)
# UPLOAD_EXT_WHITELIST=mp4,mov,mkv,avi,webm,mp3,wav,flac,aac,m4a,jpg,jpeg,png,gif,webp
# 跨域白名单(逗号分隔;前端由后端托管或走 dev 代理,通常无需配置)
# CORS_ORIGINS=
